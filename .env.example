# ── Meridian Exchange configuration ──────────────────────────────────────────

# SQLite database file (created by `npm run db:push`).
DATABASE_URL="file:./dev.db"

# Operator console + operator API (/?ops=1, /api/v1/operator, /api/v1/profiles).
# The dev fallback is `meridian-ops-2026` — set your own before exposing the
# exchange beyond localhost.
# MRX_OPERATOR_KEY=my-operator-secret

# Where the web terminal finds the Socket.IO market relay
# (mini-services/market-relay, default port 3003). Leave unset when running
# behind a fronting proxy that already routes the relay for you.
NEXT_PUBLIC_MRX_STREAM_URL=http://localhost:3003
